# Node identity. One ed25519 seed (64 hex chars, the SECRET) is the whole
# key material: the X25519 static for Noise IK is derived from it, and the
# same key signs the ServerConfig snapshot. Generated on first start into
# STORAGE_PATH/node_identity_key and printed as node_key=... — clients must
# know that public part to open a session. Set NODE_IDENTITY_KEY to pin a
# key from a secret manager instead.
# Backup, rotation and alerts: docs/runbook-node-key.md.
NODE_IDENTITY_KEY=
NOISE_HANDSHAKE_TIMEOUT_MS=10000

# Accept the XX (first contact) handshake, where the client learns the node
# key during the handshake instead of knowing it up front. Setting this to
# false leaves only pinned clients: an active MITM on first contact becomes
# impossible, at the cost of new clients needing the key out of band.
NOISE_ALLOW_TOFU=true

# Signed ServerConfig.
# How long a signed snapshot stays valid. Must be non-zero: a signed config
# without an expiry cannot be revoked.
SERVER_CONFIG_TTL_SECONDS=86400
# host:port the node advertises inside the signed snapshot. Leave empty if
# the node does not know its public address — an empty value means "not
# advertised", never "any address".
ADVERTISED_ADDRESS=

# Bind settings. BIND_ADDR has priority over BIND_HOST/BIND_PORT.
BIND_ADDR=
BIND_HOST=0.0.0.0
BIND_PORT=443

# Local storage path for sled data.
STORAGE_PATH=data

# Max accepted TCP frame size in bytes (default: 8 MiB).
MAX_FRAME_LEN=8388608

# Prometheus metrics exporter.
# If METRICS_ADDR is set, metrics are enabled automatically even if
# METRICS_ENABLED is left empty.
METRICS_ENABLED=false
METRICS_ADDR=0.0.0.0:9000

# Retention policy values:
# - positive day count: 30, 30d, 7days
# - disabled: disabled, off, none, false, infinite
# - immediate cleanup: instant, immediate, 0, 0d
DELETED_MESSAGES_RETENTION=30d
OFFLINE_MESSAGES_RETENTION=30d

# Limits and backpressure. 0 disables the individual limit.
TTL_MIN_SECONDS=86400
QUOTA_MAX_MESSAGES_PER_QUEUE=10000
QUOTA_MAX_BYTES_PER_QUEUE=67108864
QUOTA_MAX_MESSAGES_SENDER_PAIR=2000
RATE_LIMIT_SEND_MSGS_PER_SEC=100
RATE_LIMIT_SEND_BYTES_PER_DAY=268435456
LIMIT_MAX_SESSIONS_PER_USER=64
LIMIT_PING_PER_SEC=50
LIMIT_HANDSHAKE_INFLIGHT=256
LIMIT_HANDSHAKE_INFLIGHT_PER_IP=32

# Push wake-ups (FCM / APNs voip). Off unless PUSH_ENABLED=true. The ids
# below are account-specific and never committed: the JetStream compose
# override (deploy/docker-compose.override.jetstream.yml) requires them in
# the .env next to compose.
# PUSH_ENABLED=false
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=
# APNS_ENABLED=false
# APNS_KEY_PATH=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# Optional tracing filter for logs.
RUST_LOG=info
