# Словарь для libFuzzer: элементы кодирования protobuf.
#
# Без словаря фаззер угадывает байты тегов побайтно; со словарём он
# вставляет их целиком и быстрее добирается до вложенных сообщений.
#
# Ключ поля = (номер << 3) | wire_type. Здесь — ключи для номеров 1..16
# всех четырёх используемых типов.

# varint (wire type 0): номера 1..16
"\x08" "\x10" "\x18" "\x20" "\x28" "\x30" "\x38" "\x40"
"\x48" "\x50" "\x58" "\x60" "\x68" "\x70" "\x78" "\x80\x01"

# length-delimited (wire type 2): bytes, string, вложенные сообщения
"\x0a" "\x12" "\x1a" "\x22" "\x2a" "\x32" "\x3a" "\x42"
"\x4a" "\x52" "\x5a" "\x62" "\x6a" "\x72" "\x7a" "\x82\x01"

# Характерные длины: 32 байта (идентификаторы) и 64 (подпись)
"\x20"
"\x40"

# Длина логического кадра внутри Noise-канала — u32 LE
"\x00\x00\x00\x00"
"\xff\xff\xff\xff"

# Пролог транспорта
"TMN1"
